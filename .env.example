# LLM (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Matterport GraphQL (Model API) - backend only, keep secret
MATTERPORT_API_KEY=
MATTERPORT_API_TOKEN=

# Matterport Showcase SDK - used by the frontend 3D viewer, locked to this domain
MATTERPORT_SDK_KEY=
MATTERPORT_SDK_DOMAIN=localhost

# Vexcel
VEXCEL_API_KEY=

# CoStar hackathon kit (unzipped folder; default <repo>/costar-kit)
COSTAR_KIT_DIR=costar-kit

# Speech to text (dispatch calls) + text to speech (scripted calls, mayday directions)
ELEVENLABS_API_KEY=
# Voice ids per role (from the ElevenLabs voice library). Leave blank if the key has Voices: Read.
# With neither, scripted calls are voiced with macOS `say`.
ELEVENLABS_VOICE_DISPATCHER=
ELEVENLABS_VOICE_CALLER=
ELEVENLABS_VOICE_CALLER2=
ELEVENLABS_VOICE_FIREFIGHTER=
ELEVENLABS_VOICE_NARRATOR=
