{
  "utterances": [
    {
      "role": "dispatcher",
      "start": 0.28,
      "end": 2.76,
      "text": "911. What is the address of your emergency?"
    },
    {
      "role": "caller",
      "start": 4.0,
      "end": 10.52,
      "text": "6550 Maple Ridge Street, Bel Air Medical Professional Building. The big open area is on fire."
    },
    {
      "role": "dispatcher",
      "start": 11.56,
      "end": 12.8,
      "text": "Is anyone still inside?"
    },
    {
      "role": "caller",
      "start": 14.44,
      "end": 22.98,
      "text": "Our medical assistant went into storage room one twenty, the closet at the front, to grab an oxygen cart, and now she can't get past the flames."
    },
    {
      "role": "dispatcher",
      "start": 24.0,
      "end": 25.64,
      "text": "Are there any hazards in that closet?"
    },
    {
      "role": "caller",
      "start": 26.64,
      "end": 30.52,
      "text": "Yes. We keep oxygen cylinders in there, at least four of them."
    },
    {
      "role": "dispatcher",
      "start": 31.4,
      "end": 32.7,
      "text": "Is everyone else out of the building?"
    },
    {
      "role": "caller",
      "start": 33.66,
      "end": 36.16,
      "text": "Yes, everyone else is out. I'm across the street."
    },
    {
      "role": "dispatcher",
      "start": 36.98,
      "end": 39.74,
      "text": "Stay back from the building. Firefighters are on the way."
    }
  ],
