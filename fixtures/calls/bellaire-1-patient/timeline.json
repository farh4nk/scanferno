{
  "utterances": [
    {
      "role": "dispatcher",
      "start": 0.3,
      "end": 3.34,
      "text": "911, what is the address of your emergency?"
    },
    {
      "role": "caller",
      "start": 4.5,
      "end": 11.68,
      "text": "6550 Maple Ridge Street, the Bel Air Medical Building. There's smoke in the hallway in the back. It's filling up fast."
    },
    {
      "role": "dispatcher",
      "start": 12.64,
      "end": 13.3,
      "text": "Is everyone out?"
    },
    {
      "role": "caller",
      "start": 14.64,
      "end": 20.8,
      "text": "One of our patients is still inside. She uses a wheelchair. She was in an exam room near the storage closets."
    },
    {
      "role": "dispatcher",
      "start": 21.72,
      "end": 23.1,
      "text": "Any hazards we should know about?"
    },
    {
      "role": "caller",
      "start": 24.1,
      "end": 26.48,
      "text": "We keep oxygen tanks in the storage closet."
    },
    {
      "role": "caller",
      "start": 27.48,
      "end": 28.94,
      "text": "I'm in the parking lot out front."
    }
  ],
