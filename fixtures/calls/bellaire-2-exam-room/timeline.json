{
  "utterances": [
    {
      "role": "dispatcher",
      "start": 0.22,
      "end": 2.82,
      "text": "911, what is the address of your emergency?"
    },
    {
      "role": "caller",
      "start": 4.059,
      "end": 11.16,
      "text": "6550 Maple Ridge Street, the Bel Air Medical Building. There's a fire in the back hallway. The smoke is pouring out the rear door."
    },
    {
      "role": "dispatcher",
      "start": 12.06,
      "end": 13.34,
      "text": "Is anyone still inside?"
    },
    {
      "role": "caller",
      "start": 14.64,
      "end": 21.0,
      "text": "Yes. One of our nurses is stuck in exam room 104. The hallway is full of smoke, and she can't get out."
    },
    {
      "role": "dispatcher",
      "start": 22.1,
      "end": 22.7,
      "text": "Is she hurt?"
    },
    {
      "role": "caller",
      "start": 24.12,
      "end": 27.24,
      "text": "She's coughing a lot. She says the door is too hot to open."
    },
    {
      "role": "dispatcher",
      "start": 28.04,
      "end": 29.02,
      "text": "Where are you right now?"
    },
    {
      "role": "caller",
      "start": 29.94,
      "end": 32.9,
      "text": "I'm outside in the parking lot on the street side."
    },
    {
      "role": "dispatcher",
      "start": 33.68,
      "end": 35.56,
      "text": "Stay there. Help is on the way."
    }
  ],
