{
  "utterances": [
    {
      "role": "dispatcher",
      "start": 0.26,
      "end": 2.84,
      "text": "911, what's the address of your emergency?"
    },
    {
      "role": "caller",
      "start": 3.7,
      "end": 10.1,
      "text": "Eighty-eight sixty-six Gulf Freeway, the Vibe office building by the feeder road. There's a fire on the third floor."
    },
    {
      "role": "dispatcher",
      "start": 11.34,
      "end": 13.28,
      "text": "Okay, where on the third floor?"
    },
    {
      "role": "caller",
      "start": 14.12,
      "end": 19.76,
      "text": "The back of the building in the truck driving school suite. Black smoke is pouring out of the windows."
    },
    {
      "role": "dispatcher",
      "start": 20.84,
      "end": 22.1,
      "text": "Is anyone still inside?"
    },
    {
      "role": "caller",
      "start": 22.96,
      "end": 28.46,
      "text": "My coworker Maria went back for her laptop. She's in the break room, the little kitchen at the end of the hall."
    },
    {
      "role": "dispatcher",
      "start": 29.48,
      "end": 32.2,
      "text": "Do you know of any hazards? Gas, chemicals?"
    },
    {
      "role": "caller",
      "start": 33.1,
      "end": 37.16,
      "text": "The driving school keeps oxygen tanks for their first aid class in the back."
    },
    {
      "role": "dispatcher",
      "start": 38.2,
      "end": 39.32,
      "text": "Where are you right now?"
    },
    {
      "role": "caller",
      "start": 40.18,
      "end": 42.46,
      "text": "I'm outside in the front parking lot."
    }
  ],
