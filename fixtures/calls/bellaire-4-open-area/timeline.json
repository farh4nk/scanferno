{
  "utterances": [
    {
      "role": "dispatcher",
      "start": 0.22,
      "end": 2.74,
      "text": "911, what is the address of your emergency?"
    },
    {
      "role": "caller",
      "start": 3.78,
      "end": 10.24,
      "text": "6550 Maple Ridge Street, the medical building in Bel Air. There's smoke coming from the back hallway near the rear door."
    },
    {
      "role": "dispatcher",
      "start": 11.72,
      "end": 12.4,
      "text": "Is everyone out?"
    },
    {
      "role": "caller",
      "start": 13.4,
      "end": 21.02,
      "text": "No. There's an older man with a walker still in the big open area in the middle of the building. He's confused and he can't find the way out."
    },
    {
      "role": "dispatcher",
      "start": 22.0,
      "end": 22.96,
      "text": "Can he walk on his own?"
    },
    {
      "role": "caller",
      "start": 24.88,
      "end": 30.12,
      "text": "Very slowly, only with the walker. I can't get to him. The smoke is in the way."
    },
    {
      "role": "dispatcher",
      "start": 31.18,
      "end": 32.119,
      "text": "Is anyone else with him?"
    },
    {
      "role": "caller",
      "start": 33.2,
      "end": 35.96,
      "text": "No, just him. Please hurry."
    },
    {
      "role": "dispatcher",
      "start": 37.04,
      "end": 39.56,
      "text": "Stay where you are. Help is on the way."
    }
  ],
