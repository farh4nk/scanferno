{
  "utterances": [
    {
      "role": "dispatcher",
      "start": 0.26,
      "end": 2.78,
      "text": "911, what's the address of your emergency?"
    },
    {
      "role": "caller",
      "start": 3.66,
      "end": 9.38,
      "text": "It's the office building on Gulf Freeway by the Almeda exit. I don't know the number. There's smoke everywhere."
    },
    {
      "role": "dispatcher",
      "start": 10.22,
      "end": 13.16,
      "text": "Sir, is it eighty-eight sixty-six Gulf Freeway?"
    },
    {
      "role": "caller",
      "start": 14.22,
      "end": 20.3,
      "text": "Yes. Yes, that one. The fire's on the second floor. No, wait, sorry, it's the third. It's the third floor."
    },
    {
      "role": "dispatcher",
      "start": 21.16,
      "end": 22.32,
      "text": "Is everyone out of the building?"
    },
    {
      "role": "caller",
      "start": 23.38,
      "end": 31.4,
      "text": "I think two people are still up there. Actually, one just came out. So one, my manager, he was in the hallway by the copy machine."
    },
    {
      "role": "dispatcher",
      "start": 32.24,
      "end": 33.3,
      "text": "Anything else we should know?"
    },
    {
      "role": "caller",
      "start": 34.14,
      "end": 39.76,
      "text": "It smells like gas on the stairs, and the smoke is black, really black, coming from the left side."
    },
    {
      "role": "dispatcher",
      "start": 40.58,
      "end": 43.02,
      "text": "Stay away from the building. Help is on the way."
    }
  ],
